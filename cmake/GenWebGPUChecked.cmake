# Generates webgpu_checked.h: in debug builds every wgpu* function becomes a macro that
# first asserts it runs inside the render actor. A function-like macro does not expand
# recursively, so the inner call reaches the real function.
function(ui_generate_webgpu_checked out)
    set(headers ${ARGN})
    set(names "")
    foreach(h IN LISTS headers)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${h}")
        file(STRINGS "${h}" lines REGEX "^[ \t]*(WGPU_EXPORT[ \t]+)?[A-Za-z_][A-Za-z0-9_ ]*[ *]wgpu[A-Z][A-Za-z0-9]*\\(")
        foreach(line IN LISTS lines)
            if(line MATCHES "typedef" OR line MATCHES "^[ \t]*(\\*|//)")
                continue()
            endif()
            string(REGEX MATCH "wgpu[A-Z][A-Za-z0-9]*\\(" fn "${line}")
            string(REPLACE "(" "" fn "${fn}")
            list(APPEND names ${fn})
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES names)
    list(LENGTH names count)
    if(count LESS 150)
        message(FATAL_ERROR "webgpu_checked.h: only ${count} functions found; header format changed?")
    endif()
    set(body "// Generated by cmake/GenWebGPUChecked.cmake. Do not edit.\n#pragma once\n\n")
    string(APPEND body "#include <webgpu.h>\n#include <wgpu.h>\n\n#ifndef NDEBUG\n")
    string(APPEND body "void ui_gpu_check_thread(const char *fn);\n")
    foreach(fn IN LISTS names)
        string(APPEND body "#define ${fn}(...) (ui_gpu_check_thread(\"${fn}\"), ${fn}(__VA_ARGS__))\n")
    endforeach()
    string(APPEND body "#endif\n")
    file(CONFIGURE OUTPUT "${out}" CONTENT "${body}" @ONLY)
    message(STATUS "webgpu_checked.h: ${count} checked functions")
endfunction()
