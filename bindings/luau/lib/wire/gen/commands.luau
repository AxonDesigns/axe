  if not (template >= 0 and template <= 0xffffffff and template == math.floor(template) and template ~= 0) then RT.bad("instantiate_template", "template") end
  if not (#nodes <= 0xffff and #nodes >= 1 and #nodes <= 1024) then RT.bad("instantiate_template", "count") end
  local _payload = 24 + #nodes * 8
  local _at = self:op(22, _payload)
  local _buf = self.buf
  buffer.writeu32(_buf, _at + 0, template)
  buffer.writeu16(_buf, _at + 4, 24)
  buffer.writeu16(_buf, _at + 6, #nodes)
  buffer.writeu32(_buf, _at + 8, parent.index)
  buffer.writeu32(_buf, _at + 12, parent.generation)
  buffer.writeu32(_buf, _at + 16, before.index)
  buffer.writeu32(_buf, _at + 20, before.generation)
  local _p = _at + 24
  for _, _x in ipairs(nodes) do _p = R.write_template_node(_buf, _p, _x) end
  self:commit(_at, _payload)
end

-- destroy_template (23): `u32 id`: later instances of it are dropped
function Writer.destroy_template(self, id)
  if not (id >= 0 and id <= 0xffffffff and id == math.floor(id) and id ~= 0) then RT.bad("destroy_template", "id") end
  local _payload = 4
  local _at = self:op(23, _payload)
  local _buf = self.buf
  buffer.writeu32(_buf, _at + 0, id)
  self:commit(_at, _payload)
end

return Writer
